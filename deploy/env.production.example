# Production settings for the deployed API. Copy to deploy/.env.production
# (gitignored) and fill in. scripts/deploy_backend_to_hf.py stores these as
# Hugging Face Space secrets; they are never committed.

# Supabase Postgres - Project Settings -> Database -> Connection string ->
# "Transaction pooler" (IPv4-compatible; the direct host is IPv6-only on free).
DB_HOST=aws-0-<region>.pooler.supabase.com
DB_PORT=6543
DB_NAME=postgres
DB_USER=postgres.<project-ref>
DB_PASSWORD=
DB_SSLMODE=require
# The pooler caps connections per client on the free tier - keep the pool small.
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5

# Supabase Storage (feature tables) - Project Settings -> API.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_KEY=

# The deployed frontend's address, e.g. https://your-app.vercel.app
ALLOWED_ORIGINS=
# Protects /api/reload_models - any long random string.
ADMIN_API_KEY=
